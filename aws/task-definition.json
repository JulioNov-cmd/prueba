{
  "family": "prueba-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::116981775264:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "prueba-container",
      "image": "116981775264.dkr.ecr.us-east-1.amazonaws.com/prueba:latest",
      "essential": true,
      "memory": 512,
      "cpu": 128,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
